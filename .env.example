# Copy to .env.local (or run `vercel env pull .env.local`) and fill in values.
# Never commit real values. None of these may use the NEXT_PUBLIC_ prefix.

# --- Store API (required) ----------------------------------------------------
# Vercel deployment-protection bypass for the Vercel Swag Store API. Sent on
# every store API request from the server; never exposed to the browser.
BYPASS_SECRET=
# Store API base URL. Optional, defaults to the value below.
API_BASE_URL=https://vercel-agentic-swag-store-api.vercel.app/api

# --- AI Gateway + Vercel Sandbox auth (required for the agents) --------------
# Locally: `vercel env pull .env.local` writes a VERCEL_OIDC_TOKEN (expires
# after 12h — pull again). On Vercel it is provided automatically. It
# authenticates both AI Gateway model calls and Vercel Sandbox.
VERCEL_OIDC_TOKEN=
# Alternative for AI Gateway only: an AI Gateway API key.
# AI_GATEWAY_API_KEY=
# Alternative for Sandbox only (when no OIDC token is available):
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# --- Optional overrides -------------------------------------------------------
# Any AI Gateway model that supports tool use.
# SHOPPING_AGENT_MODEL=openai/gpt-4.1-mini
# ADMIN_AGENT_MODEL=openai/gpt-4.1
# Name of the persistent admin sandbox (memory + computation).
# ADMIN_SANDBOX_NAME=ship-it-shop-admin-agent-development
# Public site URL used for metadata.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
